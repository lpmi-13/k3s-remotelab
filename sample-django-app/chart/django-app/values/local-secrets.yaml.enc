# SOPS encrypted secrets for local environment
# This is a placeholder file - actual encryption requires age key setup
#
# To create the encrypted version:
# 1. Generate age key: age-keygen -o secrets/keys/local.key
# 2. Update secrets/.sops.yaml with the public key
# 3. Run: SOPS_AGE_KEY_FILE=secrets/keys/local.key sops local-secrets.yaml.enc
#
# Placeholder content (replace with encrypted version):
secrets:
  secretKey: "django-insecure-remotelab-key-change-in-production"
  database:
    user: "remotelab"
    password: "remotelab"
